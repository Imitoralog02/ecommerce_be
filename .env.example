JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL=PT30M
AUTH_REFRESH_TTL=P30D
AUTH_RESET_TTL=PT10M
AUTH_RESET_COOLDOWN=PT1M
AUTH_RESET_FROM=noreply@neora.local
# Production: use a separate random secret of at least 32 characters.
# PASSWORD_RESET_SECRET=
MAIL_HOST=localhost
MAIL_PORT=1025
# Production SMTP only:
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
AUTH_MONGODB_URI=mongodb://127.0.0.1:27018/ecommerce_auth
CATALOG_MONGODB_URI=mongodb://127.0.0.1:27018/ecommerce_catalog
ORDER_MONGODB_URI=mongodb://127.0.0.1:27018/ecommerce_order
NOTIFICATION_MONGODB_URI=mongodb://127.0.0.1:27018/ecommerce_notification
CUSTOMER_MONGODB_URI=mongodb://127.0.0.1:27018/ecommerce_customer
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ORDER_TOPIC=order.lifecycle.v1
ORDER_OUTBOX_POLL_MS=5000
INTERNAL_API_KEY=replace-with-at-least-32-random-characters
INVENTORY_DEMO_SEED_QUANTITY=20
CATALOG_SYNC_LEGACY_DEMO=false
FLASH_SALE_DEMO_SEED=true
ORDER_INVENTORY_POLL_MS=5000
PROMOTION_DEMO_SEED=true
PROMOTION_RECONCILE_MS=30000
CUSTOMER_URL=http://localhost:8086
# Optional: local-only password for scripts/seed-demo-data.ps1 (8-72 characters)
# DEMO_SEED_PASSWORD=
